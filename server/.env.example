# Copy this file to .env and fill it in. Never commit .env.
PORT=4000

# Local MongoDB for development; replace with your Atlas connection string later.
MONGODB_URI=mongodb://127.0.0.1:27017/job-tracker

# From the Clerk dashboard: Configure > API keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Which Gemini model to use. gemini-flash-latest and gemini-3.8-flash hung on a new free key; 2.5 is closed to new users.
# Tried in order: when one model's free daily limit is used up (or it's busy), the next one answers.
GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional. JSearch (Indeed, Glassdoor, Foundit… via Google for Jobs): subscribe to the free plan at
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch and paste your RapidAPI key. Left empty, JSearch is skipped.
JSEARCH_API_KEY=
# Calls allowed per 30 days, kept under the free plan's limit.
JSEARCH_MONTHLY_LIMIT=150

# Optional. Apify (Naukri + Indeed public listings, scraped on Apify's cloud; never uses your Naukri/Indeed login):
# free account at https://apify.com, then Settings > API & Integrations > Personal API token. Left empty, Apify is skipped.
APIFY_TOKEN=
# Actor runs allowed per 30 days (2 a day = 60, about $0.80 of the free $5 a month).
APIFY_MONTHLY_LIMIT=60

# Optional. Hunter.io finds HR people by company domain (free account: 50 credits a month).
HUNTER_API_KEY=
HUNTER_MONTHLY_LIMIT=25

# Each user connects their own Gmail on Profile > Sending email (address + 16-letter app password).
# The app password is stored encrypted with this key: 32+ random characters. Changing it means everyone connects again.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_SECRET_KEY=

# Optional. Make the app private: only these emails (comma-separated, verified in Clerk) can use it. Set this before hosting it.
ALLOWED_EMAILS=
DAILY_EMAIL_LIMIT=20
